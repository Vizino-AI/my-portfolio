---
/**
 * The row of category links at the top of the homepage (the blog) and each category page.
 * Plain links to static pages, so it works without JavaScript and every
 * category has its own URL to share.
 */
interface Props {
  categories: Array<{ slug: string; name: string; count: number }>;
  /** Slug of the category being shown; omit on the homepage. */
  current?: string;
  total: number;
}

const { categories, current, total } = Astro.props;
---

{categories.length > 0 && (
  <nav class="blog-nav" aria-label="Categories">
    <a href="/" aria-current={current ? undefined : 'page'}>
      All <span>{total}</span>
    </a>
    {categories.map((c) => (
      <a href={`/blog/category/${c.slug}`} aria-current={current === c.slug ? 'page' : undefined}>
        {c.name} <span>{c.count}</span>
      </a>
    ))}
  </nav>
)}

<style>
  .blog-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .blog-nav a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    color: var(--c-ink-muted);
    font-size: var(--t-small);
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .blog-nav a:hover {
    border-color: var(--c-ink-faint);
    color: var(--c-ink);
  }

  .blog-nav a[aria-current='page'] {
    border-color: var(--c-ink);
    background: var(--c-ink);
    color: var(--c-bg);
  }

  .blog-nav span {
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
</style>
