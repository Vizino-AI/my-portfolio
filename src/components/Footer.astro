---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <hr class="rule" />
    <div class="footer__inner">
      <p class="footer__meta">
        © {year} {profile.brandName} · {profile.location}
      </p>
      <p class="footer__meta">
        <a class="footer__link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-bottom: 3.5rem; }
  .footer__inner {
    padding-top: 2rem;
    text-align: center;
  }
  .footer__meta {
    font-size: var(--t-small);
    color: var(--c-ink-faint);
  }
  .footer__meta + .footer__meta { margin-top: 0.4rem; }
  .footer__link {
    color: var(--c-ink-muted);
    transition: color 0.2s var(--ease);
  }
  .footer__link:hover { color: var(--c-accent); }
</style>
