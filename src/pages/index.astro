---
// The homepage is the blog: what the studio does in one line, then the writing.
// /blog redirects here (astro.config.mjs); posts, categories and series stay under /blog/.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogNav from '../components/BlogNav.astro';
import PostGrid from '../components/PostGrid.astro';
import { getCategories, getPosts, getSeriesList } from '../utils/blog';
import { profile } from '../data/profile';

const [posts, categoryGroups, seriesList] = await Promise.all([getPosts(), getCategories(), getSeriesList()]);
const categories = categoryGroups.map((g) => g.category);
---

<BaseLayout isHome>
  <div class="home">
    <div class="container">
      <h1 class="home__title">{profile.role}</h1>

      <BlogNav
        categories={categoryGroups.map((g) => ({ slug: g.category.id, name: g.category.data.name, count: g.posts.length }))}
        total={posts.length}
      />

      <PostGrid posts={posts} categories={categories} seriesList={seriesList} />
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding: clamp(3.5rem, 8vw, 6rem) 0 4rem;
  }

  .home__title {
    max-width: 22ch;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-family: var(--f-display);
    font-size: var(--t-h1);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
  }
</style>
